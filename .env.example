# Copy to .env and fill in. The real .env is gitignored.
# Set DATA_DIR outside any cloud-synced folder if the repo lives in one.
DATA_DIR=./data

# Read by psycopg, docker-compose and the dbt profile.
PGHOST=localhost
PGPORT=5432
PGDATABASE=bankcycle
PGUSER=bankcycle
# Local database only.
PGPASSWORD=change_me

LOG_LEVEL=INFO
# true = build from data/sample only
SAMPLE_MODE=false
ECB_START_PERIOD=2019-01
HTTP_TIMEOUT_S=60
